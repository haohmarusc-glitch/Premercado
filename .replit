modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
# NÃO troque para "scheduled". Este bloco descreve o deployment DO APP, e
# "scheduled" é um job de cron: roda um comando e sai, sem servir HTTP. Publicar
# assim tira o site e a API do ar -- e o `router = "application"` e os
# `[[ports]]` abaixo ficariam sem sentido.
#
# O gatilho do scripts/trigger-checkers.sh precisa de um deployment SEPARADO,
# criado no painel de Deployments (o .replit só comporta um bloco
# [deployment]). O próprio script já anota isso ao lembrar que os secrets do
# Scheduled Deployment são independentes dos do workspace.
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 19156
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
