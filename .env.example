# Modelo do .env usado pelo docker compose fora do Replit.
#
#   cp .env.example .env   e preencha o que estiver marcado como OBRIGATÓRIO.
#
# O .env real é lido em RUNTIME pelo `env_file:` do compose -- ele nunca entra
# na imagem (ver .dockerignore). Não versione o .env.

# ── Obrigatórias ─────────────────────────────────────────────────────────────

# Domínio que o Caddy vai usar para pedir o certificado TLS. Precisa já ter um
# registro A/AAAA apontando para o IP desta máquina.
DOMINIO=premercado.seudominio.com

# Postgres do compose. O host é `db` porque esse é o nome do serviço na rede
# interna do compose -- não é localhost, o banco está em outro container.
POSTGRES_USER=premercado
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=premercado
DATABASE_URL=postgres://premercado:troque-esta-senha@db:5432/premercado

# Assina os cookies de sessão. Trocar isso desloga todo mundo.
#   openssl rand -base64 48
JWT_SECRET=

# Bearer usado pelo agente Python para chamar a própria API (memória, plano de
# saída). Sem ele o agente sobe mas não consegue salvar observação nenhuma.
#   openssl rand -base64 32
OPERATOR_API_KEY=

# Origens aceitas pelo CORS. Servindo frontend e API no mesmo domínio (que é o
# caso deste compose), basta o próprio domínio.
ALLOWED_ORIGINS=https://premercado.seudominio.com

# Pelo menos UMA chave de LLM. A ordem de fallback padrão é
# anthropic → deepseek → gemini → openrouter → openai → kimi (AGENT_PROVIDER_ORDER muda).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=

# ── Opcionais: e-mail de alerta ──────────────────────────────────────────────
# Sem SMTP_USER/SMTP_PASS o app sobe normalmente e só loga "SMTP not
# configured" -- os alertas continuam sendo gravados, só não são enviados.
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# ── Opcionais: provedores de dados de mercado ────────────────────────────────
# Cada um ausente simplesmente desliga a ferramenta correspondente do agente;
# nada quebra por falta.
FMP_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
QUIVER_API_KEY=
UNUSUAL_WHALES_API_KEY=
ROIC_API_KEY=
FORM4API_KEY=
FLASHALPHA_API_KEY=

# Exigido pela SEC no User-Agent de quem consulta o EDGAR. Sem isso as
# consultas de filing podem voltar 403.
SEC_CONTACT_EMAIL=

# ── Opcionais: ajuste de comportamento ───────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info

# Carteira do agente. Deixe VAZIO para usar a carteira do banco (Settings), que
# é o comportamento certo desde que a carteira passou a vir do DB. Preencher
# aqui força uma lista fixa e volta a ignorar o que está no Settings.
AGENT_PORTFOLIO_TICKERS=

# Cache em disco do histórico diário do yfinance. O caminho já vem apontado
# para o volume nomeado no Dockerfile; só o TTL costuma valer a pena mexer.
AGENT_HIST_CACHE_TTL_S=600
