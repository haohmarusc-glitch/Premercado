www.{$DOMINIO} {
    redir https://{$DOMINIO}{uri} permanent
}
{$DOMINIO} {
    encode zstd gzip

    handle /auth/* {
        reverse_proxy 172.17.0.1:3095
    }

    @needsAuth {
        path /netdata* /status* /logs*
        not header Cookie *monitor_ok=1*
    }
    handle @needsAuth {
        redir * /auth/login?next={uri}
    }

    handle /netdata* {
        uri strip_prefix /netdata
        reverse_proxy 172.17.0.1:19999
    }
    handle /status* {
        uri strip_prefix /status
        reverse_proxy uptime-kuma:3001
    }
    # Dozzle - repassa o caminho completo (obrigatório com DOZZLE_BASE)
    handle /logs* {
        reverse_proxy dozzle:8080
    }

    reverse_proxy app:8080 {
        flush_interval -1
    }

    log {
        output stdout
        format console
    }
}

# ── Subdomínios ─────────────────────────────────────────────────────────────
#
# Estes quatro blocos existiam SÓ NA VPS, editados direto no servidor. O arquivo
# é versionado, então o próximo `git pull` em /opt/premercado ia conflitar nele
# -- e resolver pelo caminho fácil ("descarta o local") apagaria quatro
# subdomínios de produção de uma vez, incluindo o da saúde.
#
# Segredo nenhum entra aqui. Os hashes de senha vêm do .env, como o DOMINIO já
# vinha: um hash bcrypt não é texto puro, mas é material de credencial, e
# credencial não mora em repositório que vive no GitHub. Ver deploy abaixo.

# Uptime Kuma tem DUAS portas para o mesmo container: /status no domínio
# principal (atrás do portão do monitor-gate) e este subdomínio, que existe
# porque o Kuma não funciona bem sob subcaminho -- os assets dele são
# absolutos a partir da raiz, e ele não tem o equivalente do DOZZLE_BASE.
#
# A porta de trás não pode ficar sem fechadura. O portão do monitor-gate NÃO
# serve aqui: ele seta o cookie `monitor_ok=1` em {$DOMINIO}, e cookie sem
# atributo Domain é host-only -- não acompanha o subdomínio. Então basic_auth,
# o mesmo padrão dos outros dois subdomínios deste arquivo, que não depende do
# gate (cujo código não está versionado em lugar nenhum).
kuma.{$DOMINIO} {
    encode zstd gzip
    basic_auth {
        {$KUMA_USER} {$KUMA_HASH}
    }
    reverse_proxy uptime-kuma:3001
}

# ATENÇÃO: este bloco não tem autenticação nenhuma, e só faz sentido se o
# fila-disney-api exigir o Bearer por conta própria.
#
# O bloco `filadisney` abaixo protege a página com basic_auth E injeta o token
# no servidor, de propósito, para o navegador nunca vê-lo. Este aqui expõe o
# MESMO backend sem nenhum dos dois. Se a API confia no proxy para autenticar,
# o token é contornável por quem souber este endereço.
#
# Não foi alterado porque não se sabe quem consome esta URL -- pôr basic_auth
# aqui quebraria um cliente que talvez exista. Conferir com:
#     curl -s -o /dev/null -w '%{http_code}\n' https://api-filadisney.{$DOMINIO}/
# 401/403 = a API se defende sozinha, está tudo bem.
# 200     = está aberto, e aí este bloco precisa de basic_auth ou de sumir.
api-filadisney.{$DOMINIO} {
    reverse_proxy fila-disney-api:8080
}

filadisney.{$DOMINIO} {
    encode zstd gzip

    # A senha protege a página inteira, inclusive o /api/*. É ela que substitui
    # o token que ficava no JavaScript.
    basic_auth {
        {$FILADISNEY_USER} {$FILADISNEY_HASH}
    }

    handle /api/* {
        uri strip_prefix /api
        # Quem injeta o token é AQUI, no servidor. O navegador nunca o vê.
        #
        # `WEB_API_TOKEN` NÃO era passado ao container do caddy (a compose só
        # mandava DOMINIO), então este header saía como "Bearer " vazio e a
        # injeção não acontecia. A compose agora exige a variável.
        reverse_proxy fila-disney-api:8080 {
            header_up Authorization "Bearer {env.WEB_API_TOKEN}"
        }
    }

    root * /srv/filadisney
    file_server
}

saude.{$DOMINIO} {
    encode zstd gzip
    basic_auth {
        {$SAUDE_USER} {$SAUDE_HASH}
    }
    @imagens {
        path /ohif /ohif/* /dicom-web/*
        method GET HEAD
    }
    handle @imagens {
        reverse_proxy saude-orthanc:8042
    }
    reverse_proxy saude-app:8502
}
